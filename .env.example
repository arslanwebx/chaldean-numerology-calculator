# Required for correct canonical URLs, sitemap, and metadata. Include https:// and no trailing slash.
SITE_URL=
# Public contact address shown to visitors.
CONTACT_EMAIL=
# Public publisher name or organization. Optional until supplied.
PUBLISHER_NAME=
# Optional jurisdiction. Leave blank unless reviewed and supplied by the owner.
GOVERNING_LAW=

# Optional SMTP contact delivery. The form shows an email fallback if incomplete.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional integrations, disabled unless IDs and explicit flags are both supplied.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADS_ENABLED=false
ADSENSE_PUBLISHER_ID=
